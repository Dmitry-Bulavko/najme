# Local development defaults. Copy to .env and adjust.
# Every variable used by any app must be listed here (see docs/conventions/env-vars.md).

# --- Database (compose.dev.yml) ---
POSTGRES_USER=najme
POSTGRES_PASSWORD=najme
POSTGRES_DB=najme
POSTGRES_PORT=5434
DATABASE_URL=postgresql://najme:najme@localhost:5434/najme?schema=public

# --- API ---
API_PORT=3000

# --- Web ---
WEB_PORT=3001
# Read server-side by the API status badge (apps/web/src/lib/health.ts); both optional in dev — with
# neither set, the badge renders "unavailable" without a request. Production always sets
# API_INTERNAL_URL (infra/compose.prod.yml).
PUBLIC_URL=http://localhost:3001
# API_INTERNAL_URL=http://localhost:3000/api/v1
