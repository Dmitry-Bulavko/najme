# Local development defaults. Copy to .env and adjust.
# Every variable used by any app must be listed here (see docs/conventions/env-vars.md).

# --- Database (compose.dev.yml) ---
POSTGRES_USER=najme
POSTGRES_PASSWORD=najme
POSTGRES_DB=najme
POSTGRES_PORT=5434
DATABASE_URL=postgresql://najme:najme@localhost:5434/najme?schema=public

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
GIT_SHA=dev
PUBLIC_URL=http://localhost:3000
# HS256 key for access tokens, min 32 chars. Dev-only placeholder; production uses a secret
# (openssl rand -base64 48). Rotating it signs every user out within 15 minutes.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
# Outgoing email. Dev/CI use Mailpit (compose.dev.yml): SMTP on 1025, inbox UI at
# http://localhost:8025. APP_WEB_URL is the origin used for links in emails.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Najme <no-reply@najme.local>"
APP_WEB_URL=http://localhost:3001
# Google sign-in: comma-separated public OAuth client IDs (web, iOS, Android) accepted as the token
# audience. Not a secret. Leave unset to disable Google sign-in (POST /auth/google answers 503).
# GOOGLE_CLIENT_IDS=
# Only for the api e2e tests: enables the Mailpit-backed suite (skipped when unset).
# MAILPIT_URL=http://localhost:8025
# Secure flag of the refresh cookie. Defaults to true except when NODE_ENV=development.
# AUTH_COOKIE_SECURE=false

# --- Web ---
WEB_PORT=3001
# The API status badge (apps/web/src/lib/health.ts) reaches the API via API_INTERNAL_URL if set,
# otherwise via the API section's PUBLIC_URL above (+ /api/v1) — the same single origin used in
# production (ADR-0007). With neither set, the badge renders "unavailable" without a request.
API_INTERNAL_URL=http://localhost:3000/api/v1

# --- Mobile (apps/mobile) ---
# Base URL the Expo app calls for the API, including the version prefix. Baked in at build/bundle
# time (Expo inlines EXPO_PUBLIC_* vars), never a secret. Use the machine's LAN IP instead of
# localhost when testing on a physical device via Expo Go.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
