{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "src/**/*.spec.ts",
    // Dev-only seed (passwords + fixtures) must not ship in the production image (#88).
    "src/dev-seed"
  ]
}
