{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"],
      "env": ["DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "DATABASE_URL",
        "GIT_SHA",
        "JWT_ACCESS_SECRET",
        "AUTH_COOKIE_SECURE",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "MAIL_FROM",
        "APP_WEB_URL",
        "GOOGLE_CLIENT_IDS",
        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",
        "STORAGE_PUBLIC_BASE_URL",
        "STORAGE_FORCE_PATH_STYLE"
      ]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "DATABASE_URL",
        "GIT_SHA",
        "NODE_ENV",
        "PORT",
        "PUBLIC_URL",
        "JWT_ACCESS_SECRET",
        "AUTH_COOKIE_SECURE",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "MAIL_FROM",
        "APP_WEB_URL",
        "GOOGLE_CLIENT_IDS",
        "MAILPIT_URL",
        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",
        "STORAGE_PUBLIC_BASE_URL",
        "STORAGE_FORCE_PATH_STYLE"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "DATABASE_URL",
        "GIT_SHA",
        "NODE_ENV",
        "PORT",
        "PUBLIC_URL",
        "JWT_ACCESS_SECRET",
        "AUTH_COOKIE_SECURE",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "MAIL_FROM",
        "APP_WEB_URL",
        "GOOGLE_CLIENT_IDS",
        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",
        "STORAGE_PUBLIC_BASE_URL",
        "STORAGE_FORCE_PATH_STYLE"
      ]
    }
  }
}
