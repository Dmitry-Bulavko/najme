{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"],
      "env": ["DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["DATABASE_URL", "GIT_SHA", "JWT_ACCESS_SECRET", "AUTH_COOKIE_SECURE"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "DATABASE_URL",
        "GIT_SHA",
        "NODE_ENV",
        "PORT",
        "PUBLIC_URL",
        "JWT_ACCESS_SECRET",
        "AUTH_COOKIE_SECURE"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "DATABASE_URL",
        "GIT_SHA",
        "NODE_ENV",
        "PORT",
        "PUBLIC_URL",
        "JWT_ACCESS_SECRET",
        "AUTH_COOKIE_SECURE"
      ]
    }
  }
}
