// Prisma schema for the Najme API. See ADR-0002, ADR-0005 and docs/conventions/api.md.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// The connection URL lives in `prisma.config.ts` (Prisma 7), not here. `PrismaClient` is
// constructed with a driver adapter (`@prisma/adapter-pg`), see `src/prisma/prisma.service.ts`.
datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  APPLE

  @@map("auth_provider")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@map("email_token_purpose")
}

// IDs are UUID v7 generated application-side (`newId()`), so there is no DB default.
model User {
  id               String    @id @db.Uuid
  email            String    @unique
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  displayName      String?   @map("display_name")
  avatarUrl        String?   @map("avatar_url")
  localePreference String    @default("en") @map("locale_preference")
  isPlatformAdmin  Boolean   @default(false) @map("is_platform_admin")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  authIdentities AuthIdentity[]
  refreshTokens  RefreshToken[]
  emailTokens    EmailToken[]
  memberships    Membership[]
  invitationsSent Invitation[] @relation("InvitationInvitedBy")
  reviewedBusinesses Business[] @relation("BusinessReviewedBy")

  @@map("users")
}

// Partial unique index on (provider, provider_account_id) WHERE provider_account_id IS NOT NULL
// is created with raw SQL in the migration; Prisma cannot express it.
model AuthIdentity {
  id                String       @id @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String?      @map("provider_account_id")
  passwordHash      String?      @map("password_hash")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("auth_identities")
}

model RefreshToken {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String            @id @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

// Platform-managed classification; seeded by migration (docs/architecture/data-model.md).
// `archivedAt` lands in M6-04 — categories are archived, never hard-deleted.
model Category {
  id        String   @id @db.Uuid
  slug      String   @unique
  iconKey   String?  @map("icon_key")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations CategoryTranslation[]
  businesses   Business[]

  @@map("categories")
}

// No timestamps: translation rows are replaceable configuration (data-model conventions).
model CategoryTranslation {
  id         String @id @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  locale     String
  name       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

enum City {
  ANDRIJEVICA
  BAR
  BERANE
  BIJELO_POLJE
  BUDVA
  CETINJE
  DANILOVGRAD
  GUSINJE
  HERCEG_NOVI
  KOLASIN
  KOTOR
  MOJKOVAC
  NIKSIC
  PETNJICA
  PLAV
  PLJEVLJA
  PLUZINE
  PODGORICA
  ROZAJE
  SAVNIK
  TIVAT
  TUZI
  ULCINJ
  ZABLJAK
  ZETA

  @@map("city")
}

enum BusinessStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED

  @@map("business_status")
}

enum ConfirmationMode {
  AUTO
  MANUAL

  @@map("confirmation_mode")
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF

  @@map("membership_role")
}

// CHECKs and composite index: raw SQL in the businesses_memberships migration.
model Business {
  id                        String           @id @db.Uuid
  name                      String
  slug                      String           @unique
  categoryId                String           @map("category_id") @db.Uuid
  description               String?
  timezone                  String           @default("Europe/Podgorica")
  city                      City
  address                   String?
  contactPhone              String?          @map("contact_phone")
  contactEmail              String?          @map("contact_email")
  logoKey                   String?          @map("logo_key")
  coverKey                  String?          @map("cover_key")
  confirmationMode          ConfirmationMode @default(AUTO) @map("confirmation_mode")
  cancellationWindowMinutes Int              @default(120) @map("cancellation_window_minutes")
  minBookingNoticeMinutes   Int              @default(60) @map("min_booking_notice_minutes")
  bookingHorizonDays        Int              @default(60) @map("booking_horizon_days")
  status                    BusinessStatus   @default(PENDING_APPROVAL)
  approvedAt                DateTime?        @map("approved_at") @db.Timestamptz(3)
  rejectionReason           String?          @map("rejection_reason")
  reviewedAt                DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId          String?          @map("reviewed_by_user_id") @db.Uuid
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                 DateTime?        @map("deleted_at") @db.Timestamptz(3)

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewedBy   User?         @relation("BusinessReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  memberships  Membership[]
  invitations  Invitation[]
  staffMembers StaffMember[]
  services     Service[]

  @@index([status, categoryId, city])
  @@map("businesses")
}

model Membership {
  id            String         @id @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  businessId    String         @map("business_id") @db.Uuid
  role          MembershipRole
  staffMemberId String?        @unique @map("staff_member_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

model StaffMember {
  id          String    @id @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  displayName String    @map("display_name")
  photoKey    String?   @map("photo_key")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  business    Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership  Membership?
  invitations Invitation[]
  assignments ServiceStaffAssignment[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]

  @@index([businessId])
  @@map("staff_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

// Partial unique (business_id, email) WHERE status = 'PENDING' is raw SQL in the migration.
model Invitation {
  id              String           @id @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  email           String
  role            MembershipRole
  staffMemberId   String?          @map("staff_member_id") @db.Uuid
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  tokenHash       String           @unique @map("token_hash")
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  invitedBy   User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("invitations")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

// CHECK: raw SQL in working_hours_time_off migration.
model WorkingHours {
  id            String  @id @db.Uuid
  staffMemberId String  @map("staff_member_id") @db.Uuid
  weekday       Weekday
  startMinute   Int     @map("start_minute")
  endMinute     Int     @map("end_minute")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, weekday])
  @@map("working_hours")
}

// CHECK: raw SQL in working_hours_time_off migration.
model TimeOff {
  id            String   @id @db.Uuid
  staffMemberId String   @map("staff_member_id") @db.Uuid
  startsAt      DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime @map("ends_at") @db.Timestamptz(3)
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, startsAt])
  @@map("time_off")
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT

  @@map("custom_field_type")
}

// CHECKs on services: raw SQL in the staff_services migration.
model Service {
  id                      String    @id @db.Uuid
  businessId              String    @map("business_id") @db.Uuid
  name                    String
  description             String?
  durationMinutes         Int       @map("duration_minutes")
  bufferBeforeMinutes     Int       @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes      Int       @default(0) @map("buffer_after_minutes")
  priceAmount             Int       @map("price_amount")
  priceCurrency           String    @default("EUR") @map("price_currency") @db.Char(3)
  minBookingNoticeMinutes Int?      @map("min_booking_notice_minutes")
  bookingHorizonDays      Int?      @map("booking_horizon_days")
  active                  Boolean   @default(true)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(3)

  business     Business                      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  assignments  ServiceStaffAssignment[]
  customFields ServiceCustomFieldDefinition[]

  @@index([businessId])
  @@map("services")
}

model ServiceStaffAssignment {
  id            String   @id @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  staffMemberId String   @map("staff_member_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([serviceId, staffMemberId])
  @@map("service_staff_assignments")
}

model ServiceCustomFieldDefinition {
  id         String          @id @db.Uuid
  serviceId  String          @map("service_id") @db.Uuid
  key        String
  label      String
  type       CustomFieldType
  required   Boolean         @default(false)
  options    Json?
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
  @@map("service_custom_field_definitions")
}
