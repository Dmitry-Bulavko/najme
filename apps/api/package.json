{
  "name": "@najme/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Najme REST API (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "prebuild": "npm run db:generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run db:generate && node scripts/dev.mjs",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run db:generate",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "prisma migrate deploy && vitest run --config vitest-e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@najme/contracts": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@najme/config": "workspace:*",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@swc/core": "^1.16.2",
    "eslint": "^10.11.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
