# Local development defaults for apps/mobile. Copy to apps/mobile/.env.local and adjust, or set
# these in the root .env (see docs/conventions/env-vars.md).

# Base URL the app calls for the API, including the /api/v1 prefix. Expo inlines EXPO_PUBLIC_* vars
# at bundle time, so this is never a secret. From Expo Go on a physical device, `localhost` resolves
# to the device itself — use the machine's LAN IP (e.g. http://192.168.1.10:3000/api/v1) instead.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Sign-In (public OAuth client IDs). Required together with API GOOGLE_CLIENT_IDS to show the
# "Continue with Google" button. Leave unset to hide the button (#55, #58). Needs a development
# build — the button stays hidden in Expo Go even when these are set.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
