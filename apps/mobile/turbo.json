{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID"
      ]
    },
    "test": {
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID"
      ]
    }
  }
}
