{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "env": [
        "WEB_PORT",
        "NODE_ENV",
        "PUBLIC_URL",
        "API_INTERNAL_URL",
        "GIT_SHA",
        "NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID"
      ]
    },
    "build": {
      "env": ["NODE_ENV", "NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID"]
    },
    "start": {
      "env": ["NODE_ENV", "PORT", "HOSTNAME", "PUBLIC_URL", "API_INTERNAL_URL", "GIT_SHA"]
    },
    "test": {
      "env": ["NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID"]
    }
  }
}
