# Local development defaults for apps/web. Copy to apps/web/.env.local and adjust, or set these in
# the root .env (see docs/conventions/env-vars.md).

# Dev server port (also see the root .env.example).
WEB_PORT=3001

# Used server-side by the API status badge (src/lib/health.ts). Neither is required in dev: with
# both unset the badge renders "unavailable" without making a request. In production
# (infra/compose.prod.yml) API_INTERNAL_URL is always set.
# API_INTERNAL_URL=http://localhost:3000/api/v1
# PUBLIC_URL=http://localhost:3001
