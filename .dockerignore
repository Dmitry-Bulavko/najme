# Build context excludes for `docker build` (apps/api/Dockerfile and any future app images).
# Keep anything the Dockerfiles COPY: pnpm-lock.yaml, pnpm-workspace.yaml, turbo.json, package.json,
# apps/*/package.json, packages/*, apps/*/src, apps/*/prisma, etc.

.git
.claude

**/node_modules
**/dist
**/.next
**/.turbo
**/generated
**/coverage
**/.expo
**/*.tsbuildinfo

**/.env
**/.env.*
